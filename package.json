{
  "name": "funky-secure",
  "version": "0.9.2",
  "description": "Supply-chain auditor and initializer for pnpm repositories: stateless rules, a read-only scan, and a write plan you review before anything is applied.",
  "license": "MIT",
  "author": "MaxGB23",
  "type": "module",
  "bin": {
    "funky-secure": "bin/funky-secure.js"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "golden": "node scripts/gen-golden.js",
    "self": "node bin/funky-secure.js scan --scope repo --fail-on warn",
    "prepublishOnly": "node --test && node bin/funky-secure.js scan --scope repo --fail-on warn && node scripts/release-guard.js && node scripts/pack-smoke.js",
    "pack:smoke": "node scripts/pack-smoke.js"
  },
  "keywords": [
    "supply-chain",
    "pnpm",
    "audit",
    "lockfile",
    "quarantine",
    "actions",
    "security"
  ],
  "packageManager": "pnpm@12.3.4",
  "pi": {
    "skills": [
      "skills"
    ]
  },
  "repository": "git+https://github.com/MaxGB23/funky-secure.git",
  "homepage": "https://github.com/MaxGB23/funky-secure#readme",
  "bugs": {
    "url": "https://github.com/MaxGB23/funky-secure/issues"
  }
}
