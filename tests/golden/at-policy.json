{
  "schemaVersion": 1,
  "tool": {
    "name": "funky-secure",
    "version": "0.6.0"
  },
  "scope": "all",
  "policy": {
    "preset": "baseline",
    "quarantineMinutes": 1440,
    "failOn": "error"
  },
  "provenance": {
    "preset": "baseline",
    "presetSource": "default",
    "quarantine": "declared in pnpm-workspace.yaml",
    "machine": "included"
  },
  "targets": [
    {
      "kind": "machine",
      "detail": "pnpm 12.3.4 (pnpm)"
    },
    {
      "kind": "repo-root",
      "path": "."
    },
    {
      "kind": "importer",
      "path": "."
    }
  ],
  "summary": {
    "error": 0,
    "warn": 0,
    "info": 0,
    "pass": 9,
    "skip": 3,
    "verdict": "pass"
  },
  "findings": [
    {
      "rule": "ci-no-safety-overrides",
      "status": "skip",
      "severity": "warn",
      "scope": "repo",
      "target": "ci",
      "message": "skipped: there is no workflow and no root .npmrc, so no CI install fact exists",
      "remediation": {
        "kind": "none"
      },
      "doc": "funky-secure explain ci-no-safety-overrides",
      "code": "no-ci"
    },
    {
      "rule": "pull-request-target",
      "status": "skip",
      "severity": "error",
      "scope": "repo",
      "target": "ci",
      "message": "skipped: there is no .github/workflows directory, so no workflow can declare a trigger",
      "remediation": {
        "kind": "none"
      },
      "doc": "funky-secure explain pull-request-target",
      "code": "no-ci"
    },
    {
      "rule": "workflow-permissions",
      "status": "skip",
      "severity": "warn",
      "scope": "repo",
      "target": "ci",
      "message": "skipped: there is no .github/workflows directory, so no workflow can declare permissions",
      "remediation": {
        "kind": "none"
      },
      "doc": "funky-secure explain workflow-permissions",
      "code": "no-ci"
    }
  ]
}
